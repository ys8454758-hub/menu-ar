// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════════════
//  USER & RESTAURANT
// ══════════════════════════════════════════════════════════

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  role          Role         @default(OWNER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  restaurants   Restaurant[]
  auditLogs     AdminAuditLog[]

  @@map("users")
}

enum Role {
  ADMIN
  OWNER
}

model Restaurant {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  logoUrl         String?
  address         String?
  city            String    @default("Bengaluru")
  lat             Float?
  lng             Float?
  phone           String?
  whatsapp        String?
  isActive        Boolean   @default(true)
  isOnMap         Boolean   @default(false)
  planId          String?
  planExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id])

  dishes          Dish[]
  badgeTheme      BadgeTheme?
  qrBrandTheme    QRBrandTheme?
  subscription    Subscription?
  scanEvents      ScanEvent[]
  supportTickets  SupportTicket[]
  monthlyReports  MonthlyReport[]

  @@map("restaurants")
}

// ══════════════════════════════════════════════════════════
//  DISH
// ══════════════════════════════════════════════════════════

model Dish {
  id              String    @id @default(cuid())
  name            String
  slug            String
  description     String?
  price           Float?
  isArchived      Boolean   @default(false)
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurantId    String
  restaurant      Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  model           DishModel?
  nutrition       DishNutrition?
  badges          DishBadge[]
  qrCode          QRCode?
  scanEvents      ScanEvent[]
  ingredients     Ingredient[]

  @@unique([restaurantId, slug])
  @@map("dishes")
}

// ══════════════════════════════════════════════════════════
//  3D MODEL
// ══════════════════════════════════════════════════════════

model DishModel {
  id              String    @id @default(cuid())
  glbUrl          String
  fileSizeBytes   Int?
  scaleX          Float     @default(1.0)
  scaleY          Float     @default(1.0)
  scaleZ          Float     @default(1.0)
  widthCm         Float?
  heightCm        Float?
  depthCm         Float?
  arSizeLocked    Boolean   @default(false)
  qualityRating   Int?      // 1–5, set by admin
  processingStatus ModelStatus @default(READY)
  uploadedAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dishId          String    @unique
  dish            Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)

  sizeAuditLogs   ModelSizeAuditLog[]

  @@map("dish_models")
}

enum ModelStatus {
  PROCESSING
  READY
  FAILED
}

model ModelSizeAuditLog {
  id          String    @id @default(cuid())
  modelId     String
  model       DishModel @relation(fields: [modelId], references: [id])
  changedBy   String    // email of admin who made the change
  oldScaleX   Float
  oldScaleY   Float
  oldScaleZ   Float
  newScaleX   Float
  newScaleY   Float
  newScaleZ   Float
  note        String?   // optional admin note
  changedAt   DateTime  @default(now())

  @@map("model_size_audit_logs")
}

// ══════════════════════════════════════════════════════════
//  NUTRITION
// ══════════════════════════════════════════════════════════

model DishNutrition {
  id            String      @id @default(cuid())
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  fiber         Float?
  sodium        Float?
  sugar         Float?
  servingSize   String?
  servingUnit   String?     // "g", "ml", "piece"
  dataSource    DataSource  @default(RESTAURANT_PROVIDED)
  isFlagged     Boolean     @default(false)
  flagNote      String?
  updatedAt     DateTime    @updatedAt

  dishId        String      @unique
  dish          Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)

  allergens     Allergen[]
  editHistory   NutritionEditLog[]

  @@map("dish_nutrition")
}

enum DataSource {
  RESTAURANT_PROVIDED
  ADMIN_ESTIMATED
  LAB_TESTED
}

model Allergen {
  id          String        @id @default(cuid())
  name        AllergenType
  nutritionId String
  nutrition   DishNutrition @relation(fields: [nutritionId], references: [id], onDelete: Cascade)

  @@map("allergens")
}

enum AllergenType {
  NUTS
  DAIRY
  GLUTEN
  EGG
  SOY
  SHELLFISH
  FISH
  SESAME
  MUSTARD
}

model Ingredient {
  id      String @id @default(cuid())
  name    String
  dishId  String
  dish    Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@map("ingredients")
}

model NutritionEditLog {
  id            String        @id @default(cuid())
  nutritionId   String
  nutrition     DishNutrition @relation(fields: [nutritionId], references: [id])
  editedBy      String        // email
  editedAt      DateTime      @default(now())
  snapshot      Json          // full nutrition object snapshot before edit

  @@map("nutrition_edit_logs")
}

// ══════════════════════════════════════════════════════════
//  BADGES
// ══════════════════════════════════════════════════════════

model DishBadge {
  id      String    @id @default(cuid())
  type    BadgeType
  dishId  String
  dish    Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@map("dish_badges")
}

enum BadgeType {
  VEG
  NON_VEG
  JAIN
  VEGAN
}

model BadgeTheme {
  id               String        @id @default(cuid())
  restaurantId     String        @unique
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id])

  vegColor         String        @default("#39FF14")
  nonVegColor      String        @default("#FF6B35")
  jainColor        String        @default("#FFD700")
  veganColor       String        @default("#00FFD1")

  vegLabel         String        @default("Veg")
  nonVegLabel      String        @default("Non-Veg")
  jainLabel        String        @default("Jain")
  veganLabel       String        @default("Vegan")

  fontFamily       String        @default("IBM Plex Mono")
  fontSize         String        @default("medium")
  badgeStyle       BadgeStyle    @default(SQUARE)
  badgePosition    BadgePosition @default(TOP_LEFT)
  showIcon         Boolean       @default(true)
  updatedAt        DateTime      @updatedAt

  @@map("badge_themes")
}

enum BadgeStyle {
  PILL
  SQUARE
  ROUNDED_SQUARE
  OUTLINED
  SOLID
}

enum BadgePosition {
  TOP_LEFT
  TOP_RIGHT
  BOTTOM_LEFT
  BOTTOM_RIGHT
}

// ══════════════════════════════════════════════════════════
//  QR CODE
// ══════════════════════════════════════════════════════════

model QRCode {
  id                    String    @id @default(cuid())
  dishId                String    @unique
  dish                  Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)

  uniqueCode            String    @unique @default(cuid())
  arUrl                 String    // /ar/{restaurantSlug}/{dishSlug}
  isActive              Boolean   @default(true)
  redirectUrl           String?   // redirect target for archived/deleted dishes

  pngUrl                String?
  svgUrl                String?
  pdfUrl                String?

  designConfig          Json      // full QRBrandTheme snapshot at generation time
  scanReliabilityScore  Float?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastScannedAt         DateTime?

  scanEvents            ScanEvent[]

  @@map("qr_codes")
}

model QRBrandTheme {
  id                    String              @id @default(cuid())
  restaurantId          String              @unique
  restaurant            Restaurant          @relation(fields: [restaurantId], references: [id])

  logoUrl               String?
  logoShape             LogoShape           @default(CIRCLE)
  logoSizePercent       Int                 @default(20)
  logoBorderColor       String?
  logoBorderWidth       Int                 @default(2)

  dotStyle              DotStyle            @default(ROUNDED)
  cornerSquareStyle     CornerSquareStyle   @default(EXTRA_ROUNDED)
  cornerDotStyle        CornerDotStyle      @default(DOT)

  foregroundColor       String              @default("#00FFD1")
  backgroundColor       String              @default("#0A0A0F")

  frameStyle            FrameStyle          @default(NONE)
  frameText             String?
  frameTextFont         String              @default("Orbitron")
  frameTextColor        String              @default("#00FFD1")
  frameBackgroundColor  String              @default("#0A0A0F")

  errorCorrectionLevel  ErrorCorrectionLevel @default(H)
  themeName             String              @default("Custom")

  updatedAt             DateTime            @updatedAt

  @@map("qr_brand_themes")
}

enum LogoShape {
  CIRCLE
  SQUARE
  ROUNDED_SQUARE
  SHIELD
}

enum DotStyle {
  SQUARE
  ROUNDED
  DOTS
  CLASSY
  CLASSY_ROUNDED
  EXTRA_ROUNDED
}

enum CornerSquareStyle {
  SQUARE
  EXTRA_ROUNDED
  DOT
}

enum CornerDotStyle {
  SQUARE
  DOT
}

enum FrameStyle {
  NONE
  SIMPLE_BORDER
  BANNER_BOTTOM
  BANNER_TOP
  ROUNDED_FRAME
}

enum ErrorCorrectionLevel {
  L
  M
  Q
  H
}

model PlatformQRDefaults {
  id                      String                @id @default(cuid())
  defaultDotStyle         DotStyle              @default(ROUNDED)
  defaultFrameText        String                @default("Scan to see in 3D!")
  enforceLogoWatermark    Boolean               @default(false)
  logoSizeMin             Int                   @default(10)
  logoSizeMax             Int                   @default(25)
  minContrastRatio        Float                 @default(4.5)
  defaultErrorCorrection  ErrorCorrectionLevel  @default(H)
  updatedAt               DateTime              @updatedAt

  @@map("platform_qr_defaults")
}

// ══════════════════════════════════════════════════════════
//  SCAN ANALYTICS
// ══════════════════════════════════════════════════════════

model ScanEvent {
  id            String     @id @default(cuid())
  qrCodeId      String
  qrCode        QRCode     @relation(fields: [qrCodeId], references: [id])
  dishId        String
  dish          Dish       @relation(fields: [dishId], references: [id])
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])

  scannedAt     DateTime   @default(now())
  deviceType    String?    // "mobile", "tablet", "desktop"
  os            String?    // "iOS", "Android", "Windows", etc.
  browser       String?
  lat           Float?
  lng           Float?
  city          String?
  sessionId     String?    // anonymous session for dedup

  @@index([restaurantId, scannedAt])
  @@index([dishId, scannedAt])
  @@index([qrCodeId, scannedAt])
  @@map("scan_events")
}

// ══════════════════════════════════════════════════════════
//  SUBSCRIPTION & BILLING
// ══════════════════════════════════════════════════════════

model Subscription {
  id                  String      @id @default(cuid())
  restaurantId        String      @unique
  restaurant          Restaurant  @relation(fields: [restaurantId], references: [id])

  plan                PlanTier
  status              SubStatus   @default(ACTIVE)
  razorpaySubId       String?
  razorpayCustomerId  String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean     @default(false)
  trialEndsAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  invoices            Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(cuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  razorpayPaymentId String?
  amount          Float         // in INR
  status          InvoiceStatus
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@map("invoices")
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ══════════════════════════════════════════════════════════
//  SUPPORT
// ══════════════════════════════════════════════════════════

model SupportTicket {
  id            String        @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  subject       String
  category      TicketCategory @default(GENERAL)
  status        TicketStatus  @default(OPEN)
  priority      TicketPriority @default(NORMAL)
  assignedTo    String?       // admin email
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  messages      TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  sender    String        // email
  senderRole Role
  body      String
  sentAt    DateTime      @default(now())

  @@map("ticket_messages")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL
  BILLING
  TECHNICAL
  MODEL_QUALITY
  QR_ISSUE
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ══════════════════════════════════════════════════════════
//  AUDIT & REPORTING
// ══════════════════════════════════════════════════════════

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminId     String
  admin       User      @relation(fields: [adminId], references: [id])
  action      String    // "IMPERSONATE", "MODEL_SIZE_CHANGE", "QR_OVERRIDE", etc.
  entityType  String    // "Restaurant", "Dish", "QRCode", etc.
  entityId    String
  metadata    Json?     // before/after snapshot
  performedAt DateTime  @default(now())
  ipAddress   String?

  @@map("admin_audit_logs")
}

model MonthlyReport {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  month         Int        // 1–12
  year          Int
  totalScans    Int
  topDishId     String?
  reportData    Json       // full report snapshot
  emailSentAt   DateTime?
  emailStatus   String?    // "delivered", "bounced", "failed"
  createdAt     DateTime   @default(now())

  @@unique([restaurantId, month, year])
  @@map("monthly_reports")
}
