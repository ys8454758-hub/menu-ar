generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String          @id @default(cuid())
  email       String          @unique
  name        String?
  role        Role            @default(OWNER)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  auditLogs   AdminAuditLog[]
  restaurants Restaurant[]

  @@map("users")
}

model Restaurant {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  logoUrl        String?
  address        String?
  city           String          @default("Bengaluru")
  lat            Float?
  lng            Float?
  phone          String?
  whatsapp       String?
  isActive       Boolean         @default(true)
  isOnMap        Boolean         @default(false)
  planId         String?
  planExpiresAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ownerId        String
  bannerUrl      String?
  coverImageUrl  String?
  menuQrPdfUrl   String?
  menuQrUrl      String?
  badgeTheme     BadgeTheme?
  dishes         Dish[]
  menuTheme      MenuTheme?
  monthlyReports MonthlyReport[]
  orders         Order[]
  payments       Payment[]
  qrBrandTheme   QRBrandTheme?
  owner          User            @relation(fields: [ownerId], references: [id])
  scanEvents     ScanEvent[]
  subscription   Subscription?
  supportTickets SupportTicket[]

  @@map("restaurants")
}

model Dish {
  id           String         @id @default(cuid())
  name         String
  slug         String
  description  String?
  price        Float?
  isArchived   Boolean        @default(false)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  restaurantId String
  category     String?
  badges       DishBadge[]
  model        DishModel?
  nutrition    DishNutrition?
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredients  Ingredient[]
  orderItems   OrderItem[]
  qrCode       QRCode?
  scanEvents   ScanEvent[]

  @@unique([restaurantId, slug])
  @@map("dishes")
}

model DishModel {
  id               String              @id @default(cuid())
  glbUrl           String
  fileSizeBytes    Int?
  scaleX           Float               @default(1.0)
  scaleY           Float               @default(1.0)
  scaleZ           Float               @default(1.0)
  widthCm          Float?
  heightCm         Float?
  depthCm          Float?
  arSizeLocked     Boolean             @default(false)
  qualityRating    Int?
  processingStatus ModelStatus         @default(READY)
  uploadedAt       DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  dishId           String              @unique
  annotations      Json?
  dish             Dish                @relation(fields: [dishId], references: [id], onDelete: Cascade)
  sizeAuditLogs    ModelSizeAuditLog[]

  @@map("dish_models")
}

model ModelSizeAuditLog {
  id        String    @id @default(cuid())
  modelId   String
  changedBy String
  oldScaleX Float
  oldScaleY Float
  oldScaleZ Float
  newScaleX Float
  newScaleY Float
  newScaleZ Float
  note      String?
  changedAt DateTime  @default(now())
  model     DishModel @relation(fields: [modelId], references: [id])

  @@map("model_size_audit_logs")
}

model DishNutrition {
  id          String             @id @default(cuid())
  calories    Float?
  protein     Float?
  carbs       Float?
  fat         Float?
  fiber       Float?
  sodium      Float?
  sugar       Float?
  servingSize String?
  servingUnit String?
  dataSource  DataSource         @default(RESTAURANT_PROVIDED)
  isFlagged   Boolean            @default(false)
  flagNote    String?
  updatedAt   DateTime           @updatedAt
  dishId      String             @unique
  allergens   Allergen[]
  dish        Dish               @relation(fields: [dishId], references: [id], onDelete: Cascade)
  editHistory NutritionEditLog[]

  @@map("dish_nutrition")
}

model Allergen {
  id          String        @id @default(cuid())
  name        AllergenType
  nutritionId String
  nutrition   DishNutrition @relation(fields: [nutritionId], references: [id], onDelete: Cascade)

  @@map("allergens")
}

model Ingredient {
  id     String @id @default(cuid())
  name   String
  dishId String
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@map("ingredients")
}

model NutritionEditLog {
  id          String        @id @default(cuid())
  nutritionId String
  editedBy    String
  editedAt    DateTime      @default(now())
  snapshot    Json
  nutrition   DishNutrition @relation(fields: [nutritionId], references: [id])

  @@map("nutrition_edit_logs")
}

model DishBadge {
  id     String    @id @default(cuid())
  type   BadgeType
  dishId String
  dish   Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@map("dish_badges")
}

model BadgeTheme {
  id            String        @id @default(cuid())
  restaurantId  String        @unique
  vegColor      String        @default("#39FF14")
  nonVegColor   String        @default("#FF6B35")
  jainColor     String        @default("#FFD700")
  veganColor    String        @default("#00FFD1")
  vegLabel      String        @default("Veg")
  nonVegLabel   String        @default("Non-Veg")
  jainLabel     String        @default("Jain")
  veganLabel    String        @default("Vegan")
  fontFamily    String        @default("IBM Plex Mono")
  fontSize      String        @default("medium")
  badgeStyle    BadgeStyle    @default(SQUARE)
  badgePosition BadgePosition @default(TOP_LEFT)
  showIcon      Boolean       @default(true)
  updatedAt     DateTime      @updatedAt
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])

  @@map("badge_themes")
}

model QRCode {
  id                   String      @id @default(cuid())
  dishId               String      @unique
  uniqueCode           String      @unique @default(cuid())
  arUrl                String
  isActive             Boolean     @default(true)
  redirectUrl          String?
  pngUrl               String?
  svgUrl               String?
  pdfUrl               String?
  designConfig         Json
  scanReliabilityScore Float?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  lastScannedAt        DateTime?
  dish                 Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  scanEvents           ScanEvent[]

  @@map("qr_codes")
}

model QRBrandTheme {
  id                   String               @id @default(cuid())
  restaurantId         String               @unique
  logoUrl              String?
  logoShape            LogoShape            @default(CIRCLE)
  logoSizePercent      Int                  @default(20)
  logoBorderColor      String?
  logoBorderWidth      Int                  @default(2)
  dotStyle             DotStyle             @default(ROUNDED)
  cornerSquareStyle    CornerSquareStyle    @default(EXTRA_ROUNDED)
  cornerDotStyle       CornerDotStyle       @default(DOT)
  foregroundColor      String               @default("#00FFD1")
  backgroundColor      String               @default("#0A0A0F")
  frameStyle           FrameStyle           @default(NONE)
  frameText            String?
  frameTextFont        String               @default("Orbitron")
  frameTextColor       String               @default("#00FFD1")
  frameBackgroundColor String               @default("#0A0A0F")
  errorCorrectionLevel ErrorCorrectionLevel @default(H)
  themeName            String               @default("Custom")
  updatedAt            DateTime             @updatedAt
  restaurant           Restaurant           @relation(fields: [restaurantId], references: [id])

  @@map("qr_brand_themes")
}

model PlatformQRDefaults {
  id                     String               @id @default(cuid())
  defaultDotStyle        DotStyle             @default(ROUNDED)
  defaultFrameText       String               @default("Scan to see in 3D!")
  enforceLogoWatermark   Boolean              @default(false)
  logoSizeMin            Int                  @default(10)
  logoSizeMax            Int                  @default(25)
  minContrastRatio       Float                @default(4.5)
  defaultErrorCorrection ErrorCorrectionLevel @default(H)
  updatedAt              DateTime             @updatedAt

  @@map("platform_qr_defaults")
}

model ScanEvent {
  id           String     @id @default(cuid())
  qrCodeId     String
  dishId       String
  restaurantId String
  scannedAt    DateTime   @default(now())
  deviceType   String?
  os           String?
  browser      String?
  lat          Float?
  lng          Float?
  city         String?
  sessionId    String?
  dish         Dish       @relation(fields: [dishId], references: [id])
  qrCode       QRCode     @relation(fields: [qrCodeId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, scannedAt])
  @@index([dishId, scannedAt])
  @@index([qrCodeId, scannedAt])
  @@map("scan_events")
}

model Subscription {
  id                 String     @id @default(cuid())
  restaurantId       String     @unique
  plan               PlanTier
  status             SubStatus  @default(ACTIVE)
  razorpaySubId      String?
  razorpayCustomerId String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean    @default(false)
  trialEndsAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  invoices           Invoice[]
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])

  @@map("subscriptions")
}

model Invoice {
  id                String        @id @default(cuid())
  subscriptionId    String
  razorpayPaymentId String?
  amount            Float
  status            InvoiceStatus
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
}

model SupportTicket {
  id           String          @id @default(cuid())
  restaurantId String
  subject      String
  category     TicketCategory  @default(GENERAL)
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(NORMAL)
  assignedTo   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id])
  messages     TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  sender     String
  senderRole Role
  body       String
  sentAt     DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])

  @@map("ticket_messages")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  performedAt DateTime @default(now())
  ipAddress   String?
  admin       User     @relation(fields: [adminId], references: [id])

  @@map("admin_audit_logs")
}

model MonthlyReport {
  id           String     @id @default(cuid())
  restaurantId String
  month        Int
  year         Int
  totalScans   Int
  topDishId    String?
  reportData   Json
  emailSentAt  DateTime?
  emailStatus  String?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, month, year])
  @@map("monthly_reports")
}

model Payment {
  id                String     @id @default(cuid())
  restaurantId      String
  amount            Float
  currency          String
  status            String     @default("PENDING")
  razorpayPaymentId String?
  razorpayOrderId   String?
  razorpaySignature String?
  createdAt         DateTime   @default(now())
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Order {
  id           String      @id @default(cuid())
  restaurantId String
  customerName String
  tableNumber  String?
  totalAmount  Float
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  dishId   String
  quantity Int
  price    Float
  dish     Dish   @relation(fields: [dishId], references: [id])
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model MenuTheme {
  id              String     @id @default(cuid())
  restaurantId    String     @unique
  themeName       String     @default("terminal")
  primaryColor    String?
  backgroundColor String?
  fontFamily      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("menu_themes")
}

enum Role {
  ADMIN
  OWNER
}

enum ModelStatus {
  PROCESSING
  READY
  FAILED
}

enum DataSource {
  RESTAURANT_PROVIDED
  ADMIN_ESTIMATED
  LAB_TESTED
}

enum AllergenType {
  NUTS
  DAIRY
  GLUTEN
  EGG
  SOY
  SHELLFISH
  FISH
  SESAME
  MUSTARD
}

enum BadgeType {
  VEG
  NON_VEG
  JAIN
  VEGAN
}

enum BadgeStyle {
  PILL
  SQUARE
  ROUNDED_SQUARE
  OUTLINED
  SOLID
}

enum BadgePosition {
  TOP_LEFT
  TOP_RIGHT
  BOTTOM_LEFT
  BOTTOM_RIGHT
}

enum LogoShape {
  CIRCLE
  SQUARE
  ROUNDED_SQUARE
  SHIELD
}

enum DotStyle {
  SQUARE
  ROUNDED
  DOTS
  CLASSY
  CLASSY_ROUNDED
  EXTRA_ROUNDED
}

enum CornerSquareStyle {
  SQUARE
  EXTRA_ROUNDED
  DOT
}

enum CornerDotStyle {
  SQUARE
  DOT
}

enum FrameStyle {
  NONE
  SIMPLE_BORDER
  BANNER_BOTTOM
  BANNER_TOP
  ROUNDED_FRAME
}

enum ErrorCorrectionLevel {
  L
  M
  Q
  H
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL
  BILLING
  TECHNICAL
  MODEL_QUALITY
  QR_ISSUE
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SERVED
  COMPLETED
  CANCELLED
}
