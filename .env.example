# ─── Database ──────────────────────────────────
# For local development: direct connection to Supabase Postgres
# For Vercel production: DATABASE_URL must use Supabase Connection Pooler (port 6543)
DATABASE_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres"

# ─── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Email (Resend) ────────────────────────────
RESEND_API_KEY="re_your-api-key"

# ─── Mapbox ────────────────────────────────────
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.your-mapbox-token"

# ─── Cal.com ───────────────────────────────────
NEXT_PUBLIC_CAL_LINK="your-username/your-event-type"

# ─── App ───────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="+91XXXXXXXXXX"

# ─── Billing (Razorpay) ────────────────────────
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ─── Cron ──────────────────────────────────────
CRON_SECRET="your-strong-random-secret"
